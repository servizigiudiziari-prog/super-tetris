# Environment Configuration Example
# Copy this file to .env and fill in your values

NODE_ENV=development

# Database
DATABASE_URL=postgresql://tetris:tetris_dev_password@localhost:5432/tetris_coop
DB_HOST=localhost
DB_PORT=5432
DB_USER=tetris
DB_PASSWORD=tetris_dev_password
DB_NAME=tetris_coop

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# API
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:19006

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=your-expo-access-token-here
EXPO_PROJECT_ID=your-expo-project-id

# Admin
ADMIN_EMAIL=admin@tetriscoop.com
ADMIN_PASSWORD_HASH=$2b$10$...

# Research & Analytics
ANALYTICS_EXPORT_KEY=research-key-12345
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_MOVES_PER_MINUTE=10
RATE_LIMIT_API_CALLS_PER_HOUR=1000

# Logging
LOG_LEVEL=debug

# Game Configuration
DEFAULT_TARGET_LINES=100
DEFAULT_GAME_DURATION_HOURS=24
MAX_MOVE_TIME_SECONDS=60
