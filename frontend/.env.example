# Backend API Configuration
# For local development on emulator/simulator use localhost
# For testing on physical device, use your computer's local IP address
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Expo Configuration (optional)
EXPO_PUBLIC_APP_NAME=Tetris Cooperativo Asincrono
EXPO_PUBLIC_APP_VERSION=1.0.0

# Environment
EXPO_PUBLIC_ENV=development
